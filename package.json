{
  "name": "gatherboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js && playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5"
  }
}
